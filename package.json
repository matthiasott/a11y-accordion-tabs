{
  "name": "a11y-accordion-tabs",
  "version": "1.0.2",
  "description": "A script for an accessible accordion tabs component",
  "main": "a11y-accordion-tabs",
  "files": [
    "CHANGELOG.md",
    "a11y-accordion-tabs.js",
    "a11y-accordion-tabs.min.js",
    "docs/"
  ],
  "keywords": [
    "accordion",
    "tabs",
    "component",
    "accessibility",
    "a11y"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthiasott/a11y-accordion-tabs.git"
  },
  "author": "Matthias Ott <mail@matthiasott.com> (https://matthiasott.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/matthiasott/a11y-accordion-tabs/issues"
  },
  "homepage": "https://github.com/matthiasott/a11y-accordion-tabs#readme",
  "scripts": {
    "copy": "cp a11y-accordion-tabs.js docs/main.js",
    "minify": "uglifyjs a11y-accordion-tabs.js -o a11y-accordion-tabs.min.js -c -m",
    "sass": "sass --style=expanded --no-source-map docs/styles.scss docs/styles.css",
    "watch:sass": "sass --watch --style=expanded --no-source-map docs/styles.scss docs/styles.css",
    "build": "npm run minify && npm run sass && npm run copy",
    "predeploy": "npm run build",
    "lint": "eslint a11y-accordion-tabs.js test/",
    "test": "make test",
    "setup:browser": "playwright install chromium",
    "test:browser": "mocha --timeout 30000 --reporter spec test/browser.test.js",
    "test:package": "node test/package-smoke.js",
    "test:all": "npm test && npm run test:browser && npm run test:package"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "eslint": "^8.57.1",
    "mocha": "^12.0.3",
    "playwright": "^1.65.1",
    "sass": "^1.108.2",
    "semistandard": "^17.0.0",
    "uglify-js": "^3.19.3"
  }
}
